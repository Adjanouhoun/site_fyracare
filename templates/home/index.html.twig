{% extends 'base.html.twig' %}

{% block body %}
    <header class="site-header">
        <nav class="nav shell" aria-label="{{ 'nav.main'|trans }}">
            <a class="brand" href="{{ path('app_home', {_locale: app.request.locale}) }}">
                <img class="brand-logo" src="{{ asset('images/logo-fyracare.png') }}" alt="FyraCare"><span><strong>Fyra</strong>Care</span>
            </a>
            <div class="nav-links">
                <a href="#vision">{{ 'nav.about'|trans }}</a><a href="{{ path('app_services', {_locale: app.request.locale}) }}">{{ 'nav.services'|trans }}</a><a href="#aminata">{{ 'nav.expertise'|trans }}</a><a href="#contact">{{ 'nav.contact'|trans }}</a>
            </div>
            <div class="languages" aria-label="{{ 'nav.languages'|trans }}">
                {% for locale, label in {fr: 'FR', en: 'EN', ar: 'AR'} %}<a href="{{ path('app_home', {_locale: locale}) }}" class="{{ app.request.locale == locale ? 'active' }}" lang="{{ locale }}">{{ label }}</a>{% endfor %}
            </div>
            <a class="nav-cta" href="#contact">{{ 'actions.appointment'|trans }} <span aria-hidden="true">↗</span></a>
        </nav>
    </header>

    <main>
        <section class="hero-luxe" id="vision" style="--hero-photo: url('{{ asset('images/gallery/centre.jpg') }}')">
            <div class="hero-luxe-overlay"></div>
            <div class="shell hero-luxe-content">
                <div class="hero-luxe-copy">
                    <span class="hero-pill">✦ {{ 'hero.eyebrow'|trans }}</span>
                    <h1>{{ 'hero.title_rich'|trans|raw }}</h1>
                    <p>{{ 'hero.description'|trans }}</p>
                    <div class="hero-actions"><a class="button button-light" href="#contact">{{ 'actions.appointment'|trans }} <span>↗</span></a><a class="hero-link" href="#services">{{ 'actions.discover'|trans }} <span>→</span></a></div>
                </div>
                <aside class="hero-proof" aria-label="{{ 'hero.proof_title'|trans }}">
                    <span class="proof-label">{{ 'hero.proof_label'|trans }}</span>
                    <strong>15+</strong>
                    <p>{{ 'hero.proof_text'|trans }}</p>
                    <div class="proof-people"><span>AD</span><span>FC</span><i>+</i><small>{{ 'hero.proof_clients'|trans }}</small></div>
                </aside>
            </div>
            <div class="hero-luxe-bottom"><div class="shell hero-luxe-metrics"><span>{{ 'hero.strip'|trans }}</span><div><b>01</b>{{ 'journey.pregnancy'|trans }}</div><div><b>02</b>{{ 'journey.birth'|trans }}</div><div><b>03</b>{{ 'journey.postpartum'|trans }}</div><a href="#services" aria-label="{{ 'actions.discover'|trans }}">↓</a></div></div>
        </section>

        <section class="manifesto section">
            <div class="shell manifesto-grid"><div class="section-index">01 — {{ 'manifesto.index'|trans }}</div><div class="manifesto-copy"><span class="kicker"><i></i>{{ 'manifesto.eyebrow'|trans }}</span><h2>{{ 'manifesto.title'|trans }}</h2><p>{{ 'manifesto.text'|trans }}</p></div><div class="manifesto-mark" aria-hidden="true">F<span>✦</span></div></div>
        </section>

        <section class="services-section section" id="services">
            <div class="shell">
                <div class="section-topline"><div class="section-index">02 — {{ 'services.eyebrow'|trans }}</div><p>{{ 'services.intro'|trans }}</p></div>
                <div class="services-title-row"><h2>{{ 'services.title_rich'|trans|raw }}</h2><a class="round-link" href="{{ path('app_services', {_locale: app.request.locale}) }}" aria-label="{{ 'services.all'|trans }}">↗</a></div>
                <div class="service-editorial">
                    {% set service_images = ['images/gallery/centre.jpg', 'images/gallery/perinee.jpg', 'images/gallery/damp.jpg'] %}
                    {% for service in featured_services %}
                        <article class="service-panel service-{{ loop.index }}"><img src="{{ asset(service_images[loop.index0]) }}" alt="{{ service.title(app.request.locale) }}"><div class="service-overlay"></div><span class="service-count">0{{ loop.index }}</span><div class="service-content"><span>{{ 'services.featured_label'|trans }}</span><h3>{{ service.title(app.request.locale) }}</h3><p>{{ service.description(app.request.locale) }}</p></div><a href="{{ path('app_services', {_locale: app.request.locale}) }}#{{ service.code }}" aria-label="{{ service.title(app.request.locale) }}">↗</a></article>
                    {% endfor %}
                </div>
                <div class="services-more"><p>{{ 'services.home_note'|trans }}</p><a class="button button-light" href="{{ path('app_services', {_locale: app.request.locale}) }}">{{ 'services.all'|trans }} <span>↗</span></a></div>
            </div>
        </section>

        <section class="founder-section section" id="aminata">
            <div class="shell founder-layout">
                <div class="founder-visual"><div class="founder-photo"><img src="{{ asset('images/aminatadiarra.png') }}" alt="{{ 'founder.image_alt'|trans }}"></div><div class="founder-stamp"><strong>15+</strong><span>{{ 'founder.years'|trans }}</span></div><span class="founder-outline" aria-hidden="true">FYRACARE</span></div>
                <div class="founder-copy"><div class="section-index">03 — {{ 'founder.eyebrow'|trans }}</div><span class="kicker"><i></i>{{ 'founder.role'|trans }}</span><h2>{{ 'founder.title_rich'|trans|raw }}</h2><p>{{ 'founder.text_long'|trans }}</p><div class="credentials"><div><strong>{{ 'founder.credential_one'|trans }}</strong><small>{{ 'founder.credential_one_text'|trans }}</small></div><div><strong>{{ 'founder.credential_two'|trans }}</strong><small>{{ 'founder.credential_two_text'|trans }}</small></div></div><a class="button button-dark" href="#contact">{{ 'founder.link'|trans }} <span>↗</span></a></div>
            </div>
        </section>

        <section class="experience-section section">
            <div class="shell experience-layout">
                <div class="experience-image"><img src="{{ asset('images/gallery/espace-soin.jpg') }}" alt="{{ 'experience.image_alt'|trans }}"><a href="#contact"><span>↗</span>{{ 'actions.appointment'|trans }}</a></div>
                <div class="experience-copy"><div class="section-index">04 — {{ 'experience.index'|trans }}</div><span class="kicker"><i></i>{{ 'experience.eyebrow'|trans }}</span><h2>{{ 'experience.title'|trans }}</h2><p>{{ 'experience.text'|trans }}</p><div class="experience-list"><details open><summary><b>01</b>{{ 'experience.item_one'|trans }}<span>+</span></summary><p>{{ 'experience.item_one_text'|trans }}</p></details><details><summary><b>02</b>{{ 'experience.item_two'|trans }}<span>+</span></summary><p>{{ 'experience.item_two_text'|trans }}</p></details><details><summary><b>03</b>{{ 'experience.item_three'|trans }}<span>+</span></summary><p>{{ 'experience.item_three_text'|trans }}</p></details><details><summary><b>04</b>{{ 'experience.item_four'|trans }}<span>+</span></summary><p>{{ 'experience.item_four_text'|trans }}</p></details></div></div>
            </div>
        </section>

        <section class="gallery-section section">
            <div class="shell gallery-heading"><div class="section-index">05 — {{ 'gallery.index'|trans }}</div><h2>{{ 'gallery.title'|trans }}</h2><p>{{ 'gallery.text'|trans }}</p></div>
            <div class="gallery-track"><figure class="gallery-tall"><img src="{{ asset('images/gallery/perinee.jpg') }}" alt="{{ 'gallery.alt_one'|trans }}"><figcaption>01 — {{ 'gallery.caption_one'|trans }}</figcaption></figure><figure class="gallery-wide"><img src="{{ asset('images/gallery/espace-soin.jpg') }}" alt="{{ 'gallery.alt_two'|trans }}"><figcaption>02 — {{ 'gallery.caption_two'|trans }}</figcaption></figure><figure class="gallery-tall"><img src="{{ asset('images/gallery/naturel.jpg') }}" alt="{{ 'gallery.alt_three'|trans }}"><figcaption>03 — {{ 'gallery.caption_three'|trans }}</figcaption></figure></div>
        </section>

        <section class="testimonials section">
            <div class="shell testimonials-layout">
                <div><div class="section-index">06 — {{ 'testimonials.index'|trans }}</div><span class="kicker"><i></i>{{ 'testimonials.eyebrow'|trans }}</span><h2>{{ 'testimonials.title'|trans }}</h2></div>
                <blockquote><span>“</span><p>{{ 'testimonials.quote'|trans }}</p><footer><strong>{{ 'testimonials.author'|trans }}</strong><small>{{ 'testimonials.care'|trans }}</small></footer></blockquote>
            </div>
        </section>

        <section class="booking-section section" id="contact" data-controller="booking">
            <div class="shell booking-layout">
                <div class="booking-intro"><div class="section-index">07 — {{ 'booking.index'|trans }}</div><span class="kicker"><i></i>{{ 'booking.eyebrow'|trans }}</span><h2>{{ 'booking.title'|trans }}</h2><p>{{ 'booking.text'|trans }}</p><ul><li>{{ 'booking.reassurance_one'|trans }}</li><li>{{ 'booking.reassurance_two'|trans }}</li><li>{{ 'booking.reassurance_three'|trans }}</li></ul></div>
                <div class="booking-panel">
                    <div class="booking-progress" aria-label="{{ 'booking.progress'|trans }}"><span class="active" data-booking-target="progress">1</span><i></i><span data-booking-target="progress">2</span><i></i><span data-booking-target="progress">3</span></div>
                    <form action="mailto:contact@fyracare.org" method="post" enctype="text/plain">
                        <fieldset class="booking-step" data-booking-target="step"><legend><small>01</small>{{ 'booking.step_one'|trans }}</legend><div class="care-options care-options-all">{% for service in services %}<label><input type="radio" name="soin" value="{{ service.code }}" {{ loop.first ? 'required' }}><span><b>{{ service.title(app.request.locale) }}</b><small>{{ service.description(app.request.locale)|slice(0, 70) }}{% if service.description(app.request.locale)|length > 70 %}…{% endif %}</small></span></label>{% endfor %}</div></fieldset>
                        <fieldset class="booking-step" data-booking-target="step" hidden><legend><small>02</small>{{ 'booking.step_two'|trans }}</legend><div class="booking-fields"><label>{{ 'booking.date'|trans }}<input type="date" name="date" required></label><label>{{ 'booking.time'|trans }}<select name="heure" required><option value="">{{ 'booking.choose_time'|trans }}</option><option>09:00</option><option>11:00</option><option>15:00</option><option>17:00</option></select></label></div></fieldset>
                        <fieldset class="booking-step" data-booking-target="step" hidden><legend><small>03</small>{{ 'booking.step_three'|trans }}</legend><div class="booking-fields"><label>{{ 'booking.name'|trans }}<input type="text" name="nom" autocomplete="name" required></label><label>{{ 'booking.phone'|trans }}<input type="tel" name="telephone" autocomplete="tel" required></label><label class="field-wide">{{ 'booking.note'|trans }}<textarea name="message" rows="3"></textarea></label></div></fieldset>
                        <div class="booking-actions"><button type="button" class="booking-back" data-booking-target="back" data-action="booking#previous" hidden>{{ 'booking.back'|trans }}</button><button type="button" class="booking-next" data-booking-target="next" data-action="booking#next">{{ 'booking.next'|trans }} <span>→</span></button><button type="submit" class="booking-next" data-booking-target="submit" hidden>{{ 'booking.confirm'|trans }} <span>✓</span></button></div>
                    </form>
                </div>
            </div>
        </section>

        <section class="appointment"><div class="shell appointment-inner"><span class="appointment-flower" aria-hidden="true">✽</span><div><span class="kicker kicker-light"><i></i>{{ 'appointment.eyebrow'|trans }}</span><h2>{{ 'appointment.title'|trans }}</h2></div><p>{{ 'appointment.text'|trans }}</p><a class="appointment-link" href="mailto:contact@fyracare.org"><span>{{ 'actions.appointment'|trans }}</span><b>↗</b></a></div></section>
    </main>

    <footer class="footer"><div class="shell footer-main"><a class="brand footer-brand" href="#"><img class="brand-logo" src="{{ asset('images/logo-fyracare.png') }}" alt="FyraCare"><span><strong>Fyra</strong>Care</span></a><p>{{ 'footer.note'|trans }}</p><div class="footer-links"><a href="{{ path('app_services', {_locale: app.request.locale}) }}">{{ 'nav.services'|trans }}</a><a href="#aminata">{{ 'nav.expertise'|trans }}</a><a href="#contact">{{ 'nav.contact'|trans }}</a></div></div><div class="shell footer-bottom"><span>© {{ 'now'|date('Y') }} FyraCare</span><span>Nouakchott · Mauritanie</span></div></footer>
{% endblock %}
