{% extends 'base.html.twig' %}

{% block body %}
    <header class="site-header">
        <nav class="nav container" aria-label="{{ 'nav.main'|trans }}">
            <a class="brand" href="{{ path('app_home', {_locale: app.request.locale}) }}">
                <img class="brand-logo" src="{{ asset('images/logo-fyracare.png') }}" alt="FyraCare"><span>FyraCare</span>
            </a>
            <div class="nav-links">
                <a href="#about">{{ 'nav.about'|trans }}</a>
                <a href="#services">{{ 'nav.services'|trans }}</a>
                <a href="#contact">{{ 'nav.contact'|trans }}</a>
            </div>
            <div class="languages" aria-label="{{ 'nav.languages'|trans }}">
                {% for locale, label in {fr: 'FR', en: 'EN', ar: 'AR'} %}
                    <a href="{{ path('app_home', {_locale: locale}) }}" class="{{ app.request.locale == locale ? 'active' }}" lang="{{ locale }}">{{ label }}</a>
                {% endfor %}
            </div>
            <a class="button" href="#contact">{{ 'actions.appointment'|trans }}</a>
        </nav>
    </header>

    <main>
        <section class="hero" id="about">
            <div class="hero-grid container">
                <div class="hero-copy">
                    <span class="eyebrow">{{ 'hero.eyebrow'|trans }}</span>
                    <h1>{{ 'hero.title'|trans }}</h1>
                    <p>{{ 'hero.description'|trans }}</p>
                    <div class="actions">
                        <a class="button" href="#contact">{{ 'actions.appointment'|trans }}</a>
                        <a class="button secondary" href="#services">{{ 'actions.discover'|trans }}</a>
                    </div>
                </div>
                <div class="hero-card" aria-label="{{ 'hero.visual_label'|trans }}">
                    <img src="{{ asset('images/about.jpg') }}" alt="{{ 'hero.image_alt'|trans }}">
                    <div class="quote">
                        <p>« {{ 'hero.quote'|trans }} »</p>
                        <span>{{ 'hero.quote_author'|trans }}</span>
                    </div>
                </div>
            </div>
        </section>

        <aside class="trust container" aria-label="{{ 'trust.title'|trans }}">
            <div class="trust-grid">
                <div class="trust-item"><span class="trust-icon">✦</span><div><strong>{{ 'trust.expertise'|trans }}</strong><small>{{ 'trust.expertise_text'|trans }}</small></div></div>
                <div class="trust-item"><span class="trust-icon">♡</span><div><strong>{{ 'trust.care'|trans }}</strong><small>{{ 'trust.care_text'|trans }}</small></div></div>
                <div class="trust-item"><span class="trust-icon">◌</span><div><strong>{{ 'trust.support'|trans }}</strong><small>{{ 'trust.support_text'|trans }}</small></div></div>
            </div>
        </aside>

        <section class="section" id="services">
            <div class="container">
                <div class="section-heading">
                    <span class="eyebrow">{{ 'services.eyebrow'|trans }}</span>
                    <h2>{{ 'services.title'|trans }}</h2>
                    <p>{{ 'services.intro'|trans }}</p>
                </div>
                <div class="services">
                    {% for item in ['birth', 'prenatal', 'postpartum'] %}
                        <article class="service">
                            <span class="service-number">0{{ loop.index }}</span>
                            <h3>{{ ('services.' ~ item ~ '.title')|trans }}</h3>
                            <p>{{ ('services.' ~ item ~ '.text')|trans }}</p>
                        </article>
                    {% endfor %}
                </div>
            </div>
        </section>

        <section class="section founder-section">
            <div class="founder container">
                <div class="founder-image">
                    <img src="{{ asset('images/aminatadiarra.png') }}" alt="{{ 'founder.image_alt'|trans }}">
                </div>
                <div class="founder-copy">
                    <span class="eyebrow">{{ 'founder.eyebrow'|trans }}</span>
                    <h2>{{ 'founder.title'|trans }}</h2>
                    <p>{{ 'founder.text'|trans }}</p>
                    <a class="text-link" href="#contact">{{ 'founder.link'|trans }} <span aria-hidden="true">→</span></a>
                </div>
            </div>
        </section>
    </main>

    <footer class="footer" id="contact">
        <div class="footer-row container"><strong>FyraCare</strong><span>{{ 'footer.note'|trans }}</span></div>
    </footer>
{% endblock %}
