{% set current_route = app.request.attributes.get('_route') %}
<header class="site-header{{ current_route == 'app_services' ? ' services-header' : '' }}">
    <nav class="nav shell" aria-label="{{ 'nav.main'|trans }}">
        <a class="brand" href="{{ path('app_home', {_locale: app.request.locale}) }}">
            <img class="brand-logo" src="{{ asset('images/logo-fyracare.png') }}" alt="FyraCare"><span><strong>Fyra</strong>Care</span>
        </a>
        <div class="nav-links">
            <a href="{{ path('app_home', {_locale: app.request.locale}) }}#vision">{{ 'nav.about'|trans }}</a>
            <a href="{{ path('app_services', {_locale: app.request.locale}) }}" class="{{ current_route == 'app_services' ? 'active' }}">{{ 'nav.services'|trans }}</a>
            <a href="{{ path('app_home', {_locale: app.request.locale}) }}#aminata">{{ 'nav.expertise'|trans }}</a>
            <a href="{{ path('app_home', {_locale: app.request.locale}) }}#contact">{{ 'nav.contact'|trans }}</a>
        </div>
        <div class="languages" aria-label="{{ 'nav.languages'|trans }}">
            {% for locale, label in {fr: 'FR', en: 'EN', ar: 'AR'} %}
                <a href="{{ path(current_route, {_locale: locale}) }}" class="{{ app.request.locale == locale ? 'active' }}" lang="{{ locale }}">{{ label }}</a>
            {% endfor %}
        </div>
        <a class="nav-cta" href="{{ path('app_home', {_locale: app.request.locale}) }}#contact">{{ 'actions.appointment'|trans }} <span aria-hidden="true">↗</span></a>
    </nav>
</header>
