{% extends 'base.html.twig' %}

{% block title %}{{ 'about_page.meta_title'|trans }}{% endblock %}
{% block meta_description %}{{ 'about_page.meta_description'|trans }}{% endblock %}

{% block body %}
    {% include '_header.html.twig' %}
    <main class="editorial-page">
        <section class="editorial-hero">
            <div class="shell editorial-hero-grid">
                <div class="editorial-hero-copy"><span class="kicker"><i></i>{{ 'about_page.eyebrow'|trans }}</span><h1>{{ 'about_page.title'|trans }}</h1><p>{{ 'about_page.intro'|trans }}</p></div>
                <figure><img src="{{ asset('images/gallery/centre.jpg') }}" alt="{{ 'about_page.image_alt'|trans }}"></figure>
            </div>
        </section>
        <section class="editorial-story section">
            <div class="shell editorial-story-grid">
                <aside><span>01</span><strong>{{ 'about_page.aside'|trans }}</strong></aside>
                <article><p class="editorial-lead">{{ 'about_page.paragraph_one'|trans }}</p><p>{{ 'about_page.paragraph_two'|trans }}</p><div class="editorial-highlights"><div><span>01</span><strong>{{ 'about_page.point_one'|trans }}</strong></div><div><span>02</span><strong>{{ 'about_page.point_two'|trans }}</strong></div><div><span>03</span><strong>{{ 'about_page.point_three'|trans }}</strong></div></div></article>
            </div>
        </section>
        <section class="editorial-cta"><div class="shell"><span class="kicker"><i></i>{{ 'about_page.cta_eyebrow'|trans }}</span><h2>{{ 'about_page.cta_title'|trans }}</h2><a class="button button-dark" href="{{ path('app_services', {_locale: app.request.locale}) }}">{{ 'actions.discover'|trans }} <span>→</span></a></div></section>
    </main>
    {% include '_footer.html.twig' %}
{% endblock %}
