{% if breadcrumb_items is defined and breadcrumb_items|length %}
    <nav class="breadcrumbs" aria-label="{{ 'seo.breadcrumb'|trans }}">
        <div class="shell"><ol>
            {% for item in breadcrumb_items %}
                <li>{% if item.url is defined and item.url %}<a href="{{ item.url }}">{{ item.label }}</a>{% else %}<span aria-current="page">{{ item.label }}</span>{% endif %}</li>
            {% endfor %}
        </ol></div>
    </nav>
    <script type="application/ld+json">{{ {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        'itemListElement': breadcrumb_items|map((item, key) => {
            '@type': 'ListItem',
            'position': key + 1,
            'name': item.label,
            'item': item.url is defined and item.url ? absolute_url(item.url) : canonical_url
        })
    }|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
{% endif %}
