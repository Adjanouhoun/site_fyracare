{% extends 'base.html.twig' %}

{% block title %}{{ 'expertise_page.meta_title'|trans|cms('expertise_page.meta_title') }}{% endblock %}
{% block meta_description %}{{ 'expertise_page.meta_description'|trans|cms('expertise_page.meta_description') }}{% endblock %}

{% block body %}
    {% include '_header.html.twig' %}
    {% set breadcrumb_items = [{label: 'seo.home'|trans|cms('seo.home'), url: path('app_home', {_locale: app.request.locale})}, {label: 'nav.expertise'|trans|cms('nav.expertise')}] %}
    {% include '_breadcrumbs.html.twig' %}
    <main class="editorial-page">
        <section class="editorial-hero expertise-hero">
            <div class="shell editorial-hero-grid">
                <div class="editorial-hero-copy"><span class="kicker"><i></i>{{ 'expertise_page.eyebrow'|trans|cms('expertise_page.eyebrow') }}</span><h1>{{ 'expertise_page.title'|trans|cms('expertise_page.title') }}</h1><p>{{ 'expertise_page.intro'|trans|cms('expertise_page.intro') }}</p></div>
                <figure><img src="{{ cms_image('expertise.hero_image', asset('images/aminatadiarra.webp')) }}" alt="{{ 'founder.image_alt'|trans|cms('founder.image_alt') }}" width="850" height="440" fetchpriority="high" decoding="async"></figure>
            </div>
        </section>
        <section class="editorial-story section">
            <div class="shell editorial-story-grid">
                <aside><span>01</span><strong>{{ 'expertise_page.aside'|trans|cms('expertise_page.aside') }}</strong></aside>
                <article><p class="editorial-lead">{{ 'expertise_page.paragraph_one'|trans|cms('expertise_page.paragraph_one') }}</p><p>{{ 'expertise_page.paragraph_two'|trans|cms('expertise_page.paragraph_two') }}</p><p>{{ 'expertise_page.paragraph_three'|trans|cms('expertise_page.paragraph_three') }}</p></article>
            </div>
        </section>
        <section class="expertise-credentials section"><div class="shell"><div class="section-index">02 — {{ 'expertise_page.skills_eyebrow'|trans|cms('expertise_page.skills_eyebrow') }}</div><h2>{{ 'expertise_page.skills_title'|trans|cms('expertise_page.skills_title') }}</h2><div class="editorial-highlights editorial-highlights-four"><div><span>01</span><strong>{{ 'expertise_page.skill_one'|trans|cms('expertise_page.skill_one') }}</strong></div><div><span>02</span><strong>{{ 'expertise_page.skill_two'|trans|cms('expertise_page.skill_two') }}</strong></div><div><span>03</span><strong>{{ 'expertise_page.skill_three'|trans|cms('expertise_page.skill_three') }}</strong></div><div><span>04</span><strong>{{ 'expertise_page.skill_four'|trans|cms('expertise_page.skill_four') }}</strong></div></div></div></section>
        <section class="editorial-cta"><div class="shell"><span class="kicker"><i></i>{{ 'expertise_page.cta_eyebrow'|trans|cms('expertise_page.cta_eyebrow') }}</span><h2>{{ 'expertise_page.cta_title'|trans|cms('expertise_page.cta_title') }}</h2><a class="button button-dark" href="{{ path('app_home', {_locale: app.request.locale}) }}#reservation">{{ 'actions.appointment'|trans|cms('actions.appointment') }} <span>→</span></a></div></section>
    </main>
    {% include '_footer.html.twig' %}
{% endblock %}
