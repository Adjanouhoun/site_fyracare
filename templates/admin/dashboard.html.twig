{% extends '@EasyAdmin/page/content.html.twig' %}
{% block content_title %}Tableau de bord{% endblock %}
{% block main %}
<style>.fyra-admin-grid{display:grid;grid-template-columns:repeat(4,minmax(180px,1fr));gap:20px;margin-top:24px}.fyra-stat{background:#fff;border:1px solid #e7ded7;padding:28px;box-shadow:0 12px 35px rgba(42,32,25,.05)}.fyra-stat small{display:block;color:#786d66;text-transform:uppercase;letter-spacing:.08em}.fyra-stat strong{display:block;font-size:2.7rem;color:#a96857;margin:10px 0}.fyra-stat a{color:#29231f;font-weight:600;text-decoration:none}@media(max-width:900px){.fyra-admin-grid{grid-template-columns:1fr 1fr}}</style>
<p>Bienvenue dans l’espace de gestion FyraCare. Retrouvez ici les demandes qui nécessitent votre attention.</p>
<div class="fyra-admin-grid">
 <article class="fyra-stat"><small>Nouvelles demandes</small><strong>{{ pendingAppointments }}</strong><a href="{{ path('admin_appointment_index') }}">Voir les rendez-vous →</a></article>
 <article class="fyra-stat"><small>Rendez-vous confirmés</small><strong>{{ upcomingAppointments }}</strong><a href="{{ path('admin_appointment_index') }}">Consulter l’agenda →</a></article>
 <article class="fyra-stat"><small>Nouveaux messages</small><strong>{{ newMessages }}</strong><a href="{{ path('admin_contact_message_index') }}">Lire les messages →</a></article>
 <article class="fyra-stat"><small>Avis à modérer</small><strong>{{ pendingTestimonials }}</strong><a href="{{ path('admin_testimonial_index') }}">Modérer les avis →</a></article>
</div>
{% endblock %}
