{% extends 'base.html.twig' %}

{% block title %}{{ 'services_page.meta_title'|trans }}{% endblock %}
{% block meta_description %}{{ 'services_page.meta_description'|trans }}{% endblock %}

{% block body %}
    {% include '_header.html.twig' %}

    <main>
        <section class="services-page-hero">
            <div class="shell services-page-intro"><span class="hero-pill">✦ {{ 'services_page.eyebrow'|trans }}</span><h1>{{ 'services_page.title_rich'|trans|raw }}</h1><p>{{ 'services_page.intro'|trans }}</p></div>
            <div class="services-page-image"><img src="{{ asset('images/gallery/perinee.jpg') }}" alt="{{ 'services_page.image_alt'|trans }}"></div>
        </section>

        <section class="services-catalog-section section" id="catalogue">
            <div class="shell">
                <div class="service-catalog-heading"><span>{{ 'services.catalog_eyebrow'|trans }}</span><h2>{{ 'services.catalog_title'|trans }}</h2><p>{{ 'services.catalog_text'|trans }}</p></div>
                <div class="service-catalog">
                    {% for service in services %}<article class="service-card" id="{{ service.code }}"><span class="service-card-number">{{ '%02d'|format(loop.index) }}</span><div class="service-card-icon" aria-hidden="true">{{ ['✦','◌','◇','✺','⌁','○','☾','❋'][loop.index0 % 8] }}</div><h3>{{ service.title(app.request.locale) }}</h3><p>{{ service.description(app.request.locale)|slice(0, 180) }}{% if service.description(app.request.locale)|length > 180 %}…{% endif %}</p><div class="service-price">{% if service.price %}<strong>{{ service.price|number_format(0, ',', ' ') }}</strong> <span>MRU</span>{% else %}<span>{{ 'services.price_on_request'|trans }}</span>{% endif %}</div><div class="service-card-actions"><a href="{{ path('app_service_show', {_locale: app.request.locale, code: service.code}) }}">{{ 'services.read_more'|trans }} <span>→</span></a><a href="{{ path('app_home', {_locale: app.request.locale, service: service.code}) }}#reservation">{{ 'services.book'|trans }} <span>↗</span></a></div></article>{% endfor %}
                </div>
            </div>
        </section>

        <section class="appointment" id="reservation"><div class="shell appointment-inner"><span class="appointment-flower" aria-hidden="true">✽</span><div><span class="kicker kicker-light"><i></i>{{ 'appointment.eyebrow'|trans }}</span><h2>{{ 'appointment.title'|trans }}</h2></div><p>{{ 'appointment.text'|trans }}</p><a class="appointment-link" href="{{ path('app_home', {_locale: app.request.locale}) }}#reservation"><span>{{ 'actions.appointment'|trans }}</span><b>↗</b></a></div></section>
    </main>

    <footer class="footer"><div class="shell footer-main"><a class="brand footer-brand" href="{{ path('app_home', {_locale: app.request.locale}) }}"><img class="brand-logo" src="{{ asset('images/logo-fyracare.png') }}" alt="FyraCare"><span><strong>Fyra</strong>Care</span></a><p>{{ 'footer.note'|trans }}</p><div class="footer-links"><a href="{{ path('app_home', {_locale: app.request.locale}) }}">{{ 'services_page.back_home'|trans }}</a><a href="#catalogue">{{ 'nav.services'|trans }}</a><a href="{{ path('app_contact', {_locale: app.request.locale}) }}">{{ 'nav.contact'|trans }}</a></div></div><div class="shell footer-bottom"><span>© {{ 'now'|date('Y') }} FyraCare</span><span>Nouakchott · Mauritanie</span></div></footer>
{% endblock %}
