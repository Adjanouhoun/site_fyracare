{% extends 'base.html.twig' %}

{% block title %}{{ service.title(app.request.locale) }} — FyraCare{% endblock %}
{% block meta_description %}{{ service.description(app.request.locale)|slice(0, 155) }}{% endblock %}

{% block body %}
    {% include '_header.html.twig' %}
    <main>
        <section class="service-detail-hero"><div class="shell service-detail-heading"><a class="detail-back" href="{{ path('app_services', {_locale: app.request.locale}) }}">← {{ 'service_detail.back'|trans }}</a><span class="hero-pill">✦ {{ 'service_detail.eyebrow'|trans }}</span><h1>{{ service.title(app.request.locale) }}</h1><div class="detail-price">{% if service.price %}<strong>{{ service.price|number_format(0, ',', ' ') }}</strong> <span>MRU</span>{% else %}{{ 'services.price_on_request'|trans }}{% endif %}</div></div></section>
        <section class="service-detail-content section"><div class="shell detail-layout"><div class="detail-copy"><div class="section-index">01 — {{ 'service_detail.about'|trans }}</div><p>{{ service.description(app.request.locale) }}</p><a class="button button-dark" href="{{ path('app_home', {_locale: app.request.locale}) }}#contact">{{ 'actions.appointment'|trans }} <span>↗</span></a></div><div class="detail-gallery">{% for image in service_images %}<figure><img src="{{ asset('images/services-details/' ~ image) }}" alt="{{ service.title(app.request.locale) }} — FyraCare" loading="{{ loop.first ? 'eager' : 'lazy' }}"></figure>{% endfor %}</div></div></section>
        <section class="appointment"><div class="shell appointment-inner"><span class="appointment-flower" aria-hidden="true">✽</span><div><span class="kicker kicker-light"><i></i>{{ 'appointment.eyebrow'|trans }}</span><h2>{{ 'appointment.title'|trans }}</h2></div><p>{{ 'appointment.text'|trans }}</p><a class="appointment-link" href="{{ path('app_home', {_locale: app.request.locale}) }}#contact"><span>{{ 'actions.appointment'|trans }}</span><b>↗</b></a></div></section>
    </main>
{% endblock %}
