{% extends 'base.html.twig' %}
{% block title %}{{ article.seoTitle(app.request.locale) }}{% endblock %}
{% block meta_description %}{{ article.seoDescription(app.request.locale) }}{% endblock %}
{% block og_type %}article{% endblock %}
{% block og_image %}{{ absolute_url(article.image ? asset('uploads/articles/'~article.image) : asset(article.category == 'wellbeing' ? 'images/gallery/damp.webp' : (article.category == 'postpartum' ? 'images/gallery/perinee.webp' : 'images/gallery/centre.webp'))) }}{% endblock %}
{% block social_meta %}<meta property="article:published_time" content="{{ article.publishedAt|date('c') }}"><meta property="article:modified_time" content="{{ article.updatedAt|date('c') }}"><meta property="article:author" content="{{ article.author }}"><meta property="article:section" content="{{ ('advice_page.categories.'~article.category)|trans }}">{% endblock %}
{% block structured_data %}<script type="application/ld+json">{{ {'@context':'https://schema.org','@type':'BlogPosting','headline':article.title(app.request.locale),'description':article.seoDescription(app.request.locale),'datePublished':article.publishedAt|date('c'),'dateModified':article.updatedAt|date('c'),'author':{'@type':'Person','name':article.author,'url':absolute_url(path('app_expertise',{_locale:app.request.locale}))},'publisher':{'@type':'Organization','name':'FyraCare','logo':{'@type':'ImageObject','url':absolute_url(asset('images/logo-fyracare.png'))}},'mainEntityOfPage':absolute_url(path('app_advice_show',{_locale:app.request.locale,slug:article.slug}))}|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>{% endblock %}
{% block body %}
{% include '_header.html.twig' %}
{% set fallback = article.category == 'wellbeing' ? 'images/gallery/damp.webp' : (article.category == 'postpartum' ? 'images/gallery/perinee.webp' : 'images/gallery/centre.webp') %}
<main class="advice-detail">
  {% set breadcrumb_items = [{label:'seo.home'|trans,url:path('app_home',{_locale:app.request.locale})},{label:'nav.advice'|trans,url:path('app_advice',{_locale:app.request.locale})},{label:article.title(app.request.locale)}] %}{% include '_breadcrumbs.html.twig' %}
  <section class="editorial-hero advice-detail-hero"><div class="shell editorial-hero-grid"><div class="editorial-hero-copy"><span class="kicker"><i></i>{{ ('advice_page.categories.'~article.category)|trans }}</span><h1>{{ article.title(app.request.locale) }}</h1><p>{{ article.excerpt(app.request.locale) }}</p><div class="advice-meta"><span>{{ article.author }}</span><time datetime="{{ article.updatedAt|date('Y-m-d') }}">{{ 'advice_page.updated'|trans }} {{ article.updatedAt|date('d.m.Y') }}</time></div></div><figure><img src="{{ article.image ? asset('uploads/articles/'~article.image) : asset(fallback) }}" alt="{{ article.title(app.request.locale) }}" fetchpriority="high" decoding="async"></figure></div></section>
  <section class="editorial-story advice-story section">
    <div class="shell editorial-story-grid">
      <aside><span>01</span><div class="blog-author"><b>AD</b><div><strong>{{ article.author }}</strong><small>{{ 'advice_page.author_role'|trans }}</small></div></div>
        <nav class="article-share" aria-label="{{ 'advice_page.share'|trans }}"><strong>{{ 'advice_page.share'|trans }}</strong><div>
          <a href="https://www.facebook.com/sharer/sharer.php?u={{ absolute_url(path('app_advice_show',{_locale:app.request.locale,slug:article.slug}))|url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4.2c-.5-.1-2-.2-3.7-.2C9.9 4 8 5.8 8 9v3H5v4h3v8h4v-8h3.3l.7-4h-4V9.4C12 8.4 12.4 8 14 8Z"/></svg><span class="sr-only">Facebook</span></a>
          <a href="https://wa.me/?text={{ (article.title(app.request.locale)~' '~absolute_url(path('app_advice_show',{_locale:app.request.locale,slug:article.slug})))|url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.6 0 .3 5.3.3 11.8c0 2.1.5 4.1 1.6 5.9L.2 24l6.5-1.7a12 12 0 0 0 5.4 1.3c6.5 0 11.8-5.3 11.8-11.8 0-3.1-1.2-6.1-3.4-8.3Zm-8.4 18.1c-1.7 0-3.4-.5-4.9-1.4l-.4-.2-3.8 1 1-3.7-.2-.4a9.7 9.7 0 1 1 8.3 4.7Zm5.3-7.3c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.2l-.9 1.1c-.2.2-.5.2-.8.1-2-.9-3.4-2.5-4.3-4.3-.1-.3 0-.6.2-.8l.6-.7c.2-.2.2-.4.3-.6.1-.2 0-.5 0-.7l-.9-2.1c-.2-.5-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.4-1.2 1.2-1.2 2.9s1.2 3.3 1.4 3.5c.2.2 2.4 3.7 5.9 5.2.8.4 1.5.6 2 .7.8.3 1.6.2 2.2.1.7-.1 1.7-.7 1.9-1.4.2-.7.2-1.3.2-1.4-.1-.2-.4-.3-.7-.4Z"/></svg><span class="sr-only">WhatsApp</span></a>
        </div></nav>
      </aside>
      <div><article class="advice-body"><p class="advice-lead">{{ article.excerpt(app.request.locale) }}</p>{{ article.content(app.request.locale)|nl2br }}</article><div class="advice-disclaimer"><strong>{{ 'advice_page.disclaimer'|trans }}</strong><p>{{ 'advice_page.disclaimer_text'|trans }}</p></div><a class="editorial-link" href="{{ path('app_advice',{_locale:app.request.locale}) }}">← {{ 'advice_page.all'|trans }}</a></div>
    </div>
  </section>
  {% if related_articles|length %}<section class="related-posts section"><div class="shell"><div class="blog-section-heading"><div><span>02 — {{ 'advice_page.continue'|trans }}</span><h2>{{ 'advice_page.related'|trans }}</h2></div></div><div class="advice-grid">{% for related in related_articles %}{% set related_fallback = related.category == 'wellbeing' ? 'images/gallery/damp.webp' : (related.category == 'postpartum' ? 'images/gallery/perinee.webp' : 'images/gallery/centre.webp') %}<article class="advice-card"><a class="advice-card-image" href="{{ path('app_advice_show',{_locale:app.request.locale,slug:related.slug}) }}"><img src="{{ related.image ? asset('uploads/articles/'~related.image) : asset(related_fallback) }}" alt="{{ related.title(app.request.locale) }}" loading="lazy"></a><div><div class="blog-meta"><span>{{ ('advice_page.categories.'~related.category)|trans }}</span><time>{{ related.publishedAt|date('d.m.Y') }}</time></div><h3><a href="{{ path('app_advice_show',{_locale:app.request.locale,slug:related.slug}) }}">{{ related.title(app.request.locale) }}</a></h3><a class="editorial-link" href="{{ path('app_advice_show',{_locale:app.request.locale,slug:related.slug}) }}">{{ 'advice_page.read'|trans }} →</a></div></article>{% endfor %}</div></div></section>{% endif %}
  <section class="editorial-cta"><div class="shell"><span class="kicker"><i></i>FyraCare</span><h2>{{ 'advice_page.cta_title'|trans }}</h2><p>{{ 'advice_page.cta_text'|trans }}</p><a class="button button-dark" href="{{ path('app_home',{_locale:app.request.locale}) }}#reservation">{{ 'actions.appointment'|trans }} →</a></div></section>
</main>
{% include '_footer.html.twig' %}
{% endblock %}
