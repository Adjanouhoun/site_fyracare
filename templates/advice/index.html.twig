{% extends 'base.html.twig' %}
{% block title %}{{ 'advice_page.meta_title'|trans }}{% endblock %}
{% block meta_description %}{{ 'advice_page.meta_description'|trans }}{% endblock %}
{% block body %}
{% include '_header.html.twig' %}
{% set breadcrumb_items = [{label:'seo.home'|trans,url:path('app_home',{_locale:app.request.locale})},{label:'nav.advice'|trans}] %}{% include '_breadcrumbs.html.twig' %}
<main>
  <header class="blog-masthead"><div class="shell"><span class="kicker"><i></i>{{ 'advice_page.eyebrow'|trans }}</span><h1>{{ 'advice_page.title'|trans }}</h1><p>{{ 'advice_page.intro'|trans }}</p></div></header>
  {% if articles|length %}{% set lead = articles|first %}{% set lead_fallback = lead.category == 'wellbeing' ? 'images/gallery/damp.webp' : (lead.category == 'postpartum' ? 'images/gallery/perinee.webp' : 'images/gallery/centre.webp') %}
  <section class="blog-featured section"><div class="shell blog-featured-grid"><a class="blog-featured-image" href="{{ path('app_advice_show',{_locale:app.request.locale,slug:lead.slug}) }}"><img src="{{ lead.image ? asset('uploads/articles/'~lead.image) : asset(lead_fallback) }}" alt="{{ lead.title(app.request.locale) }}" fetchpriority="high" decoding="async"></a><article><div class="blog-meta"><span>{{ 'advice_page.latest'|trans }}</span><span>{{ ('advice_page.categories.'~lead.category)|trans }}</span><time datetime="{{ lead.publishedAt|date('Y-m-d') }}">{{ lead.publishedAt|date('d.m.Y') }}</time></div><h2><a href="{{ path('app_advice_show',{_locale:app.request.locale,slug:lead.slug}) }}">{{ lead.title(app.request.locale) }}</a></h2><p>{{ lead.excerpt(app.request.locale) }}</p><div class="blog-author"><span>AD</span><div><strong>{{ lead.author }}</strong><small>{{ 'advice_page.author_role'|trans }}</small></div></div><a class="button button-dark" href="{{ path('app_advice_show',{_locale:app.request.locale,slug:lead.slug}) }}">{{ 'advice_page.read'|trans }} <span>→</span></a></article></div></section>
  {% endif %}
  <section class="blog-list section"><div class="shell"><div class="blog-section-heading"><div><span>02 — {{ 'advice_page.featured_eyebrow'|trans }}</span><h2>{{ 'advice_page.all'|trans }}</h2></div><p>{{ 'advice_page.featured_text'|trans }}</p></div><div class="advice-grid blog-grid">
    {% for article in articles %}{% if not loop.first %}
      {% set fallback = article.category == 'wellbeing' ? 'images/gallery/damp.webp' : (article.category == 'postpartum' ? 'images/gallery/perinee.webp' : 'images/gallery/centre.webp') %}
      <article class="advice-card"><a class="advice-card-image" href="{{ path('app_advice_show',{_locale:app.request.locale,slug:article.slug}) }}"><img src="{{ article.image ? asset('uploads/articles/'~article.image) : asset(fallback) }}" alt="{{ article.title(app.request.locale) }}" loading="lazy" decoding="async"></a><div><div class="blog-meta"><span>{{ ('advice_page.categories.'~article.category)|trans }}</span><time datetime="{{ article.publishedAt|date('Y-m-d') }}">{{ article.publishedAt|date('d.m.Y') }}</time></div><h2><a href="{{ path('app_advice_show',{_locale:app.request.locale,slug:article.slug}) }}">{{ article.title(app.request.locale) }}</a></h2><p>{{ article.excerpt(app.request.locale) }}</p><a class="editorial-link" href="{{ path('app_advice_show',{_locale:app.request.locale,slug:article.slug}) }}">{{ 'advice_page.read'|trans }} →</a></div></article>
    {% endif %}{% else %}<p>{{ 'advice_page.no_articles'|trans }}</p>{% endfor %}
  </div></div></section>
  <section class="appointment"><div class="shell appointment-inner"><span class="appointment-flower" aria-hidden="true">✽</span><div><span class="kicker kicker-light"><i></i>{{ 'appointment.eyebrow'|trans }}</span><h2>{{ 'appointment.title'|trans }}</h2></div><p>{{ 'appointment.text'|trans }}</p><a class="appointment-link" href="{{ path('app_home',{_locale:app.request.locale}) }}#reservation"><span>{{ 'actions.appointment'|trans }}</span><b>↗</b></a></div></section>
</main>
{% include '_footer.html.twig' %}
{% endblock %}
