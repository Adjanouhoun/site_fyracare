{% extends 'base.html.twig' %}
{% block title %}{{ 'advice_page.meta_title'|trans }}{% endblock %}
{% block meta_description %}{{ 'advice_page.meta_description'|trans }}{% endblock %}
{% block body %}
{% include '_header.html.twig' %}
{% set breadcrumb_items = [{label:'seo.home'|trans,url:path('app_home',{_locale:app.request.locale})},{label:'nav.advice'|trans}] %}{% include '_breadcrumbs.html.twig' %}
<main>
  <section class="services-page-hero advice-page-hero"><div class="shell services-page-intro"><span class="hero-pill">✦ {{ 'advice_page.eyebrow'|trans }}</span><h1>{{ 'advice_page.title'|trans }}</h1><p>{{ 'advice_page.intro'|trans }}</p></div><div class="services-page-image"><img src="{{ asset('images/gallery/centre.webp') }}" alt="{{ 'advice_page.title'|trans }}" width="1600" height="900" fetchpriority="high" decoding="async"></div></section>
  <section class="services-catalog-section advice-catalog section"><div class="shell"><div class="service-catalog-heading"><span>{{ 'advice_page.featured_eyebrow'|trans }}</span><h2>{{ 'advice_page.all'|trans }}</h2><p>{{ 'advice_page.featured_text'|trans }}</p></div><div class="advice-grid">
    {% for article in articles %}
      {% set fallback = article.category == 'wellbeing' ? 'images/gallery/damp.webp' : (article.category == 'postpartum' ? 'images/gallery/perinee.webp' : 'images/gallery/centre.webp') %}
      <article class="advice-card"><a class="advice-card-image" href="{{ path('app_advice_show',{_locale:app.request.locale,slug:article.slug}) }}"><img src="{{ article.image ? asset('uploads/articles/'~article.image) : asset(fallback) }}" alt="{{ article.title(app.request.locale) }}" loading="lazy" decoding="async"></a><div><span>{{ ('advice_page.categories.'~article.category)|trans }}</span><h2><a href="{{ path('app_advice_show',{_locale:app.request.locale,slug:article.slug}) }}">{{ article.title(app.request.locale) }}</a></h2><p>{{ article.excerpt(app.request.locale) }}</p><a class="editorial-link" href="{{ path('app_advice_show',{_locale:app.request.locale,slug:article.slug}) }}">{{ 'advice_page.read'|trans }} →</a></div></article>
    {% else %}<p>{{ 'advice_page.no_articles'|trans }}</p>{% endfor %}
  </div></div></section>
  <section class="appointment"><div class="shell appointment-inner"><span class="appointment-flower" aria-hidden="true">✽</span><div><span class="kicker kicker-light"><i></i>{{ 'appointment.eyebrow'|trans }}</span><h2>{{ 'appointment.title'|trans }}</h2></div><p>{{ 'appointment.text'|trans }}</p><a class="appointment-link" href="{{ path('app_home',{_locale:app.request.locale}) }}#reservation"><span>{{ 'actions.appointment'|trans }}</span><b>↗</b></a></div></section>
</main>
{% include '_footer.html.twig' %}
{% endblock %}
