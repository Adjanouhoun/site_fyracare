<!DOCTYPE html>
<html lang="{{ app.request.locale }}" dir="{{ app.request.locale == 'ar' ? 'rtl' : 'ltr' }}">
    <head>
        {% set current_route = app.request.attributes.get('_route') %}
        {% set current_params = app.request.attributes.get('_route_params') ?? {} %}
        {% set is_localized = current_route and current_params._locale is defined %}
        {% set canonical_url = current_route ? absolute_url(path(current_route, current_params)) : absolute_url(app.request.pathInfo) %}
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="{% block meta_description %}{{ 'meta.description'|trans|cms('meta.description') }}{% endblock %}">
        <meta name="theme-color" content="#f6eee8">
        <meta property="og:type" content="{% block og_type %}website{% endblock %}">
        <meta property="og:site_name" content="FyraCare">
        <meta property="og:title" content="{% block og_title %}{{ block('title') }}{% endblock %}">
        <meta property="og:description" content="{{ block('meta_description') }}">
        <meta property="og:image" content="{% block og_image %}{{ absolute_url(asset('images/gallery/centre.webp')) }}{% endblock %}">
        <meta property="og:url" content="{{ canonical_url }}">
        <meta property="og:locale" content="{{ app.request.locale == 'ar' ? 'ar_MR' : (app.request.locale == 'en' ? 'en_MR' : 'fr_MR') }}">
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ block('title') }}">
        <meta name="twitter:description" content="{{ block('meta_description') }}">
        <meta name="twitter:image" content="{{ block('og_image') }}">
        {% block social_meta %}{% endblock %}
        <link rel="canonical" href="{{ canonical_url }}">
        {% if is_localized %}
            {% for locale in ['fr', 'en', 'ar'] %}<link rel="alternate" hreflang="{{ locale }}" href="{{ absolute_url(path(current_route, current_params|merge({_locale: locale}))) }}">{% endfor %}
            <link rel="alternate" hreflang="x-default" href="{{ absolute_url(path(current_route, current_params|merge({_locale: 'fr'}))) }}">
        {% endif %}
        <title>{% block title %}{{ 'meta.title'|trans|cms('meta.title') }}{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><circle cx=%2232%22 cy=%2232%22 r=%2230%22 fill=%22%23A96857%22/><path d=%22M20 18h26v7H28v8h15v7H28v14h-8z%22 fill=%22white%22/></svg>">
        {% block stylesheets %}
        {% endblock %}

        <script type="application/ld+json">{{ {
            '@context': 'https://schema.org',
            '@type': 'MedicalClinic',
            '@id': absolute_url(path('app_home', {_locale: 'fr'})) ~ '#clinic',
            'name': 'FyraCare',
            'description': 'meta.description'|trans|cms('meta.description'),
            'url': absolute_url(path('app_home', {_locale: app.request.locale})),
            'logo': absolute_url(asset('images/logo-fyracare.png')),
            'image': absolute_url(asset('images/gallery/centre.webp')),
            'telephone': ['contact.phone_primary'|trans|cms('contact.phone_primary'), 'contact.phone_secondary'|trans|cms('contact.phone_secondary')],
            'email': 'contact.email_value'|trans|cms('contact.email_value'),
            'address': {
                '@type': 'PostalAddress',
                'streetAddress': 'Cité Plage Sapeur-Pompier',
                'addressLocality': 'Nouakchott',
                'addressCountry': 'MR'
            },
            'geo': {'@type': 'GeoCoordinates', 'latitude': 18.103504, 'longitude': -16.015177},
            'availableLanguage': ['fr', 'en', 'ar'],
            'founder': {
                '@type': 'Person',
                '@id': absolute_url(path('app_expertise', {_locale: 'fr'})) ~ '#aminata',
                'name': 'Aminata Boulkheir Diarra',
                'jobTitle': 'Sage-femme',
                'url': absolute_url(path('app_expertise', {_locale: app.request.locale}))
            }
        }|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
        {% block structured_data %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

    </head>
    <body class="locale-{{ app.request.locale }}">
        {% block body %}{% endblock %}
    </body>
</html>
