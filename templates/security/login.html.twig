{% extends 'base.html.twig' %}
{% block title %}Connexion — FyraCare{% endblock %}
{% block body %}<main class="login-page"><form method="post" class="login-card"><img src="{{ asset('images/logo-fyracare.png') }}" alt="FyraCare"><span>Administration sécurisée</span><h1>Bienvenue</h1>{% if error %}<div class="login-error">Identifiants incorrects.</div>{% endif %}<label>Adresse e-mail<input type="email" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus></label><label>Mot de passe<input type="password" name="_password" autocomplete="current-password" required></label><input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><button type="submit">Se connecter <b>→</b></button><a href="{{ path('app_home', {_locale:'fr'}) }}">← Retour au site</a></form></main>{% endblock %}
