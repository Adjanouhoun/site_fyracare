{% extends 'base.html.twig' %}
{% block title %}{{ 'contact.meta_title'|trans }}{% endblock %}
{% block meta_description %}{{ 'contact.meta_description'|trans }}{% endblock %}
{% block body %}
{% include '_header.html.twig' %}
<main class="inner-page contact-page">
 <section class="page-hero"><div class="shell"><span class="kicker"><i></i>{{ 'contact.eyebrow'|trans }}</span><h1>{{ 'contact.title'|trans }}</h1><p>{{ 'contact.intro'|trans }}</p></div></section>
 <section class="section"><div class="shell contact-layout">
  <aside class="contact-details"><h2>{{ 'contact.details_title'|trans }}</h2><address><div><small>{{ 'contact.address_label'|trans }}</small><strong>Cité Plage Sapeur-Pompier<br>Nouakchott, Mauritanie</strong></div><div><small>{{ 'contact.phone_label'|trans }}</small><a href="tel:+22241468484">+222 41 46 84 84</a><a href="tel:+22244122686">+222 44 12 26 86</a></div><div><small>{{ 'contact.email_label'|trans }}</small><a href="mailto:Contact@fyracare.com">Contact@fyracare.com</a></div></address><a class="button button-dark" href="https://www.google.com/maps?q=18.103504,-16.015177" rel="noopener" target="_blank">{{ 'contact.map'|trans }} ↗</a></aside>
  <div class="contact-form-panel"><h2>{{ 'contact.form_title'|trans }}</h2>{% for message in app.flashes('contact_success') %}<p class="form-notice success">{{ message|trans }}</p>{% endfor %}{{ form_start(contact_form) }}<div class="contact-fields">{{ form_row(contact_form.name) }}{{ form_row(contact_form.email) }}{{ form_row(contact_form.phone) }}{{ form_row(contact_form.subject) }}<div class="field-wide">{{ form_row(contact_form.message) }}</div></div>{{ form_widget(contact_form.website) }}<button class="booking-next" type="submit">{{ 'contact.submit'|trans }} <span>→</span></button>{{ form_end(contact_form) }}</div>
 </div></section>
</main>
{% include '_footer.html.twig' %}
{% endblock %}
