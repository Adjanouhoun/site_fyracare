{% extends 'base.html.twig' %}
{% block title %}{{ 'contact.meta_title'|trans|cms('contact.meta_title') }}{% endblock %}
{% block meta_description %}{{ 'contact.meta_description'|trans|cms('contact.meta_description') }}{% endblock %}
{% block body %}
{% include '_header.html.twig' %}
{% set breadcrumb_items = [{label: 'seo.home'|trans|cms('seo.home'), url: path('app_home', {_locale: app.request.locale})}, {label: 'nav.contact'|trans|cms('nav.contact')}] %}
{% include '_breadcrumbs.html.twig' %}
<main class="inner-page contact-page">
 <section class="page-hero"><div class="shell"><span class="kicker"><i></i>{{ 'contact.eyebrow'|trans|cms('contact.eyebrow') }}</span><h1>{{ 'contact.title'|trans|cms('contact.title') }}</h1><p>{{ 'contact.intro'|trans|cms('contact.intro') }}</p></div></section>
 <section class="section"><div class="shell contact-layout">
  <aside class="contact-details"><span class="contact-panel-index">01</span><h2>{{ 'contact.details_title'|trans|cms('contact.details_title') }}</h2><address><div><small>{{ 'contact.address_label'|trans|cms('contact.address_label') }}</small><strong>Cité Plage Sapeur-Pompier<br>Nouakchott, Mauritanie</strong></div><div><small>{{ 'contact.phone_label'|trans|cms('contact.phone_label') }}</small><a href="tel:+22241468484">+222 41 46 84 84</a><a href="tel:+22244122686">+222 44 12 26 86</a></div><div><small>{{ 'contact.email_label'|trans|cms('contact.email_label') }}</small><a href="mailto:Contact@fyracare.com">Contact@fyracare.com</a></div></address><a class="button button-dark" href="https://www.google.com/maps?q=18.103504,-16.015177" rel="noopener" target="_blank">{{ 'contact.map'|trans|cms('contact.map') }} ↗</a></aside>
  <div class="contact-form-panel"><span class="contact-panel-index">02</span><h2>{{ 'contact.form_title'|trans|cms('contact.form_title') }}</h2>{% for message in app.flashes('contact_success') %}<p class="form-notice success">{{ message|trans }}</p>{% endfor %}{{ form_start(contact_form) }}<div class="contact-fields">{{ form_row(contact_form.name) }}{{ form_row(contact_form.email) }}{{ form_row(contact_form.phone) }}{{ form_row(contact_form.subject) }}<div class="field-wide">{{ form_row(contact_form.message) }}</div></div>{{ form_widget(contact_form.website) }}<button class="booking-next contact-submit" type="submit">{{ 'contact.submit'|trans|cms('contact.submit') }} <span>→</span></button>{{ form_end(contact_form) }}</div>
 </div></section>
</main>
{% include '_footer.html.twig' %}
{% endblock %}
